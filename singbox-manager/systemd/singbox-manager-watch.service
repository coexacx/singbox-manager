[Unit]
Description=Check active sing-box connection and switch on failure
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/lib/singbox-manager/installed

[Service]
Type=oneshot
Environment=PYTHONUTF8=1 PYTHONIOENCODING=utf-8
ExecStart=/usr/bin/python3 /usr/local/lib/singbox-manager/node_manager.py watch
UMask=0077
TimeoutStartSec=infinity
