[Unit]
Description=sing-box Telegram status notification
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=sing-box
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
ExecStart=/usr/bin/python3 /usr/local/lib/singbox-manager/telegram_monitor.py notify
TimeoutStartSec=120
